# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service_role key (Project Settings > API) — bypasses RLS, server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# seri's own OpenRouter key — server-side secret, forwarded requests use THIS key, never the
# caller's. Never ship this to the CLI.
SERI_OPENROUTER_API_KEY=your-openrouter-key
# WorkOS client id used to verify the CLI's access tokens (JWKS) and, if unset, defaults to the
# same staging client id the CLI itself ships (apps/cli/src/auth/deviceFlow.ts). Only set this to
# point the server at a different WorkOS environment than the CLI's default.
# SERI_WORKOS_CLIENT_ID=client_your-workos-client-id
# Free tier's daily request-count cap. Optional, defaults to 50 — a placeholder pending real
# usage data, per docs-tmp/pricing-tiers.md.
# SERI_FREE_DAILY_REQUESTS=50
# Paid tiers' daily request-count cap (independent of their dollar-spend allowance — bounds
# abort-abuse where a stream is cancelled before its final usage frame). Optional, defaults to
# 500 — also a placeholder pending real usage data.
# SERI_PAID_DAILY_REQUESTS=500
# Polar webhook signing secret (Polar dashboard > Webhooks > your endpoint)
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# Polar organization access token (Polar dashboard > Settings > Developers) — needed here too,
# not just by apps/portal: the gateway route auto-provisions a Free subscription when an
# authenticated user has none (see lib/entitlement.ts's resolveEntitlement).
POLAR_ACCESS_TOKEN=your-polar-access-token
# Which Polar environment to talk to: sandbox or production. Anything else is read as sandbox.
POLAR_SERVER=sandbox
# Polar product ids — used to resolve the plan a subscription is on. They differ between
# sandbox and production, so they are configuration rather than constants.
POLAR_PRODUCT_FREE=your-free-product-id
POLAR_PRODUCT_PRO=your-pro-product-id
POLAR_PRODUCT_MAX=your-max-product-id
POLAR_PRODUCT_ULTRA=your-ultra-product-id
